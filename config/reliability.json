    "min_encounters_per_condition": 10,
    "max_false_clear_upper_95": 0.01,
    "min_center_accuracy": 0.95,
    "min_required_object_recall": 0.90,
    "min_uncertainty_action_rate": 0.95,
    "max_inspection_p95_s": 6.0
  }
